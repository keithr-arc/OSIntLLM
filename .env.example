# OSIntLLM Environment Configuration
# Copy this file to .env and fill in your API keys

# Shodan API
# Get your API key from: https://www.shodan.io/account/profile
SHODAN_API_KEY=your_shodan_api_key_here

# Censys API
# Get your credentials from: https://censys.io/account/api
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here

# GreyNoise API
# Get your API key from: https://www.greynoise.io/account/api
GREYNOISE_API_KEY=your_greynoise_api_key_here

# AbuseIPDB API
# Get your API key from: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Optional: Request timeout in seconds
# TIMEOUT=30

# Optional: Maximum number of retries for failed requests
# MAX_RETRIES=3

# Optional: Delay between requests in seconds (to avoid rate limiting)
# REQUEST_DELAY=1.0
